digraph flow {
 graph [rankdir=TB,bgcolor="white",pad=.3,nodesep=.45,ranksep=.5];
 node [fontname="DejaVu Sans",fontsize=12,shape=box,style="rounded,filled",fillcolor="#eff6ff",color="#93c5fd"];
 edge [fontname="DejaVu Sans",fontsize=10,color="#64748b"];
 start [shape=oval,label="Launch CampusFix",fillcolor="#dbeafe"];
 login [label="User enters demo credentials"];
 auth [shape=diamond,label="Credentials\nvalid?",fillcolor="#fff7ed",color="#fdba74"];
 denied [label="Show validation error",fillcolor="#fee2e2",color="#fca5a5"];
 role [shape=diamond,label="User role?",fillcolor="#fff7ed",color="#fdba74"];
 student [label="Student: submit / view\ncomplaints"];
 tech [label="Technician: review\nassigned / advance status"];
 admin [label="Admin: prioritize / assign\n/ export / monitor"];
 check [label="Validate permissions\nand workflow"];
 persist [label="Save to SQLite via JDBC\n(or local file fallback)",fillcolor="#dcfce7",color="#86efac"];
 refresh [label="Refresh dashboard &\nnotify UI listener",fillcolor="#dcfce7",color="#86efac"];
 start->login->auth;auth->denied [label="No"];denied->login;auth->role [label="Yes"];
 role->student [label="Student"];role->tech [label="Technician"];role->admin [label="Admin"];
 student->check;tech->check;admin->check;check->persist->refresh;
}
